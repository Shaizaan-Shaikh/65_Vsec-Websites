{
  "name": "travel-itinerary-budget-planner",
  "version": "1.0.0",
  "private": true,
  "description": "A local VSET travel itinerary and budget planner",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "db": "node --env-file-if-exists=.env scripts/start-db.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
